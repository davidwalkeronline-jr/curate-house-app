# Slack Bot Token (requires scopes: channels:history, channels:read, groups:history,
# groups:read, im:history, im:read, mpim:history, mpim:read, users:read, chat:write)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Your Slack User ID (find in Slack profile > "..." > Copy member ID)
SLACK_USER_ID=U12345678

# Set to "true" to send digest as DM (optional)
SEND_DM=false

# Output file path for JSON digest (optional)
OUTPUT_FILE=
